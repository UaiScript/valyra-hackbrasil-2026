# Configuração de desenvolvimento local. Copie para .env.
POSTGRES_DB=valyra
POSTGRES_USER=valyra
# Valor de exemplo, exclusivo para o banco local de demonstração.
POSTGRES_PASSWORD=valyra
# Altere para 5433 se a porta 5432 já estiver ocupada na sua máquina.
POSTGRES_PORT=5432

# Ajuste também a porta das URLs se POSTGRES_PORT mudar.
DATABASE_URL=postgresql+psycopg://valyra:valyra@localhost:5432/valyra
TEST_DATABASE_URL=postgresql+psycopg://valyra:valyra@localhost:5432/valyra_test
CORS_ORIGIN=http://127.0.0.1:5173
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# --- LLM (ADR-0002) ---
# Primário: Gemini 2.5 Flash. Chave: https://aistudio.google.com/apikey
# Vazio mantém a API utilizável e faz chamadas de IA falharem de forma controlada.
GEMINI_API_KEY=
# Timeout por operação HTTP, total de tentativas por provedor e teto de saída.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=2048

# Fallback: GPT-4o-mini — ativado quando OPENAI_API_KEY estiver presente.
# Configure um hard spend limit no projeto da OpenAI antes da apresentação:
# https://platform.openai.com/settings/organization/limits
OPENAI_API_KEY=
