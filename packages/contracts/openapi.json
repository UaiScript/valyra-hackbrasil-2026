    "/api/v1/ai/explain": {
      "post": {
        "description": "O servidor autoriza a conta do usu\u00e1rio demo e monta o contexto corrente. Sem evid\u00eancias eleg\u00edveis, retorna insufici\u00eancia sem chamar o provedor. N\u00e3o persiste conversa, n\u00e3o faz replay hist\u00f3rico nem calcula resumo/proje\u00e7\u00e3o.",
        "operationId": "ai_explain",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplainRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplainResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ACCOUNT_NOT_FOUND: conta inexistente ou alheia"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "VALIDATION_ERROR: corpo inv\u00e1lido"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "AI_CONFIGURATION_ERROR ou AI_CONTEXT_INVALID: falha de prepara\u00e7\u00e3o"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "AI_INVALID_RESPONSE: sa\u00edda inv\u00e1lida ou rejeitada pelo dom\u00ednio"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "AI_UNAVAILABLE: provedor sem chave, cota ou acesso"
          }
        },
        "summary": "Explicar evid\u00eancias da conta",
        "tags": [
          "ai"
        ]
      }
    },
