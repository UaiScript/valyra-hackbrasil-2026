# Configuração pública incorporada ao build. Nunca coloque segredos em VITE_*.
# Enquanto a aplicação não estiver publicada, mantenha o destino no repositório.
VITE_SYSTEM_URL=https://github.com/UaiScript/valyra-hackbrasil-2026
# Use application somente quando VITE_SYSTEM_URL apontar para a aplicação oficial.
VITE_DESTINATION_KIND=repository
